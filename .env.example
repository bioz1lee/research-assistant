# 비밀 값은 이 파일에만 둡니다 (config.json에 넣지 말 것).
# 이 파일을 `.env` 로 복사해서 값을 채우세요. `.env` 는 git에 올라가지 않습니다.
# 서버 시작 시 server.py가 자동으로 읽습니다.

# 텔레그램 알림을 쓸 때만 필요합니다. 안 쓰면 비워두세요.
# @BotFather 에서 봇을 만들면 토큰을 받을 수 있습니다.
TELEGRAM_BOT_TOKEN=

# 선택 사항. PubMed 검색 속도 제한이 초당 3건 → 10건으로 늘어납니다.
# https://account.ncbi.nlm.nih.gov/settings/ 에서 무료로 발급.
NCBI_API_KEY=
